{
  "scripts": {
    "start": "go test -cover -count=1 ./...",
    "watch": "nodemon --exec 'go test -cover -count=1 ./...' --ext go",
    "bench": "go test -benchmem -bench=. ./...",
    "modernize": "modernize -fix ./...",
    "update": "rm -f go.mod go.sum && go mod init && go get -u && go mod tidy"
  }
}
